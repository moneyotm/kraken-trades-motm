# Copy this file to .env and paste in your own keys:
#     cp .env.example .env
# Then lock the file down so only you can read it:
#     chmod 600 .env
#
# .env is listed in .gitignore and is never committed. Never paste these
# values into a Claude Code chat, a screenshot, or a Discord message.
#
# Create keys at https://www.kraken.com/u/security/api
# Kraken shows the "API Key" and the "Private Key" once. The Private Key
# is what goes in the SECRET line below.
# Turn on ONLY: query funds, query open/closed orders and trades,
# create and modify orders, cancel and close orders.
# Leave every withdrawal, deposit, and transfer permission OFF.

# Account "main" (see accounts.json)
KRAKEN_API_KEY=paste_your_api_key_here
KRAKEN_API_SECRET=paste_your_private_key_here

# Account "second" (optional). Leave these blank if you only use one account.
KRAKEN_API_KEY_2=
KRAKEN_API_SECRET_2=

# OPTIONAL: withdrawals. Leave these blank and withdrawals stay off.
# If you turn them on, use a SEPARATE key with only "Query funds" and
# "Withdraw funds". Never add withdraw permission to the trading key above.
# See "Optional. Withdrawals" in SETUP.md.
KRAKEN_WITHDRAW_KEY=
KRAKEN_WITHDRAW_SECRET=
KRAKEN_WITHDRAW_KEY_2=
KRAKEN_WITHDRAW_SECRET_2=
